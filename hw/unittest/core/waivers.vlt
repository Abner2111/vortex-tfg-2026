`verilator_config

// Preexistente en VX_core (VX_lsu_slice/lsu_agu), no relacionado con la
// integración de la L1 del TFG -- este unittest nunca se había construido
// antes (main.cpp era un stub), así que este waiver nunca hizo falta.
// VX_mem_bus_if.sv es compartido por todo Vortex, así que el waiver va
// acá (scoped a este proyecto) en vez de con pragmas inline en el
// archivo compartido -- mismo criterio que hw/unittest/l1_cache/
// hw/unittest/snoop_bus.
lint_off -rule UNUSEDSIGNAL -file "*/hw/rtl/mem/VX_mem_bus_if.sv"
